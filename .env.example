# ALFWorld data and experiment mode
ALFWORLD_DATA=/absolute/path/to/AdaMEM/data/alfworld
SPLIT=eval_in_distribution
MEM_TYPE=adamem-low

# Policy/action model (OpenAI-compatible chat-completions endpoint)
POLICY_BACKEND=vllm
MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
OPENAI_BASE_IP_ADDR=127.0.0.1:8001

# Strategy model used to create/update AdaMEM's online short-term memory.
# Example: a third-party OpenAI-compatible HTTPS API.
STRATEGY_BACKEND=openai-compatible
STRATEGY_MODEL_NAME=provider/model-name
STRATEGY_BASE_URL=https://api.provider.example/v1
STRATEGY_API_KEY=replace-me
STRATEGY_MAX_TOKENS=4096
STRATEGY_MAX_CONCURRENCY=10

# Embedding model used both when building and querying the HNSW index.
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1

# Namespace of the model that generated the stored trajectories. This selects
# retrieval_data/<env>/<model>/; it is not an inference endpoint.
MEMORY_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

# Optional runtime settings
RETRIEVAL_TOPK=1
CORRECT_ONLY=true
EVAL_BATCH_SIZE=140
TEST_TIMES=1
BASE_SEED=1
# Training only: 0 disables early stopping; set to 200 for a small success library.
TARGET_SUCCESS_TRAJECTORIES=0
